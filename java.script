import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpHandler;
import com.sun.net.httpserver.HttpServer;
import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.OutputStream;
import java.net.InetSocketAddress;

public class Servidor {

    public static void main(String[] args) throws IOException {
        // Define a porta do servidor (8080 é o padrão para Java)
        int porta = 8080;
        HttpServer servidor = HttpServer.create(new InetSocketAddress(porta), 0);
        
        // Configura o servidor para responder na rota principal "/"
        servidor.createContext("/", new GestorArquivos());
        servidor.setExecutor(null); 
        
        System.out.println("Servidor Java iniciado com sucesso!");
        System.out.println("Disponível na porta: " + porta);
        servidor.start();
    }

    // Gerenciador que lê os arquivos do site e envia para o navegador
    static class GestorArquivos implements HttpHandler {
        @Override
        public void handle(HttpExchange troca) throws IOException {
            String caminhoRequisitado = troca.getRequestURI().getPath();
            
            // Se acessar a raiz "/", entrega o index.html
            if (caminhoRequisitado.equals("/")) {
                caminhoRequisitado = "/index.html";
            }

            // Procura o arquivo na pasta atual do Codespaces
            File arquivo = new File("." + caminhoRequisitado);

            if (arquivo.exists() && !arquivo.isDirectory()) {
                // Define o tipo de arquivo correto para o navegador entender
                String tipoConteudo = "text/plain";
                if (caminhoRequisitado.endsWith(".html")) tipoConteudo = "text/html; charset=UTF-8";
                else if (caminhoRequisitado.endsWith(".css")) tipoConteudo = "text/css";
                else if (caminhoRequisitado.endsWith(".mp4")) tipoConteudo = "video/mp4";
                else if (caminhoRequisitado.endsWith(".jpg") || caminhoRequisitado.endsWith(".jpeg")) tipoConteudo = "image/jpeg";
                else if (caminhoRequisitado.endsWith(".webp")) tipoConteudo = "image/webp";

                troca.getResponseHeaders().set("Content-Type", tipoConteudo);
                troca.sendResponseHeaders(200, arquivo.length());

                // Transmite o arquivo para o navegador
                try (OutputStream os = troca.getResponseBody();
                     FileInputStream fis = new FileInputStream(arquivo)) {
                    byte[] buffer = new byte[4096];
                    int bytesLidos;
                    while ((bytesLidos = fis.read(buffer)) != -1) {
                        os.write(buffer, 0, bytesLidos);
                    }
                }
            } else {
                // Erro 404 se o arquivo não for encontrado
                String respostaErro = "<h1>404 - Arquivo Não Encontrado</h1>";
                troca.getResponseHeaders().set("Content-Type", "text/html; charset=UTF-8");
                troca.sendResponseHeaders(404, respostaErro.length());
                try (OutputStream os = troca.getResponseBody()) {
                    os.write(respostaErro.getBytes());
                }
            }
        }
    }
}

